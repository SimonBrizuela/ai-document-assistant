# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT Configuration (use a secure random string, min 256 bits)
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-minimum-256-bits

# AWS Configuration (for production)
AWS_REGION=us-east-1
AWS_S3_BUCKET=ai-assistant-documents

# Database Configuration (docker-compose handles this)
# Uncomment for manual setup
# DATABASE_URL=jdbc:postgresql://localhost:5432/aiassistant
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres

# Optional: AI Provider Selection
# AI_PROVIDER=openai
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
